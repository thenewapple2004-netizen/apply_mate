# Copy to .env and change the values. Never commit .env.

# Postgres (used by the db service, and to build the backend's DATABASE_URL in compose.yaml)
POSTGRES_USER=apply_mate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apply_mate

# Gemini (CV analysis). Used only by the backend; never sent to the extension.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash
GEMINI_MODEL=
# Optional: used when the main model's quota runs out or it is overloaded (each model has its
# own quota). Defaults to gemini-2.5-flash; write "none" to disable.
GEMINI_FALLBACK_MODEL=
# Optional: "on" lets the model think longer (slower). Default "off" is much faster.
GEMINI_THINKING=
