{
  "name": "job-fellow-extension",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered assistant for job applications.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test tests/core.test.ts",
    "postinstall": "wxt prepare",
    "build:test": "node scripts/build-test.mjs",
    "demo": "node scripts/demo-server.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
